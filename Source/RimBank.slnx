<Solution>
  <Configurations>
    <BuildType Name="Release" />
  </Configurations>
  <Project Path="RimBank.Core/RimBank.Core.csproj">
    <BuildDependency Project="RimBank.Trade/RimBank.Trade.csproj" />
  </Project>
  <Project Path="RimBank.Trade/RimBank.Trade.csproj" />
  <Folder Name="/.github/">
    <File Path="../.github/copilot-instructions.md" />
  </Folder>
  <Folder Name="/XML/Languages/English/Keyed/">
    <File Path="../Languages/English/Keyed/Core.xml" />
    <File Path="../Languages/English/Keyed/TradeUI.xml" />
  </Folder>
  <Folder Name="/XML/About/">
    <File Path="../About/about.xml" />
  </Folder>
  <Folder Name="/XML/Defs/">
    <File Path="../Defs/Building_RimBankTerminal.xml" />
    <File Path="../Defs/Item_BankNote.xml" />
    <File Path="../Defs/Job.xml" />
  </Folder>
  <Folder Name="/XML/Patches/">
    <File Path="../Patches/StockGenerator_Banknotes.xml" />
  </Folder>
</Solution>